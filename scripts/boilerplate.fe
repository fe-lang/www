// Common stubs for documentation snippets.
// This file is automatically prepended to all Fe code blocks during type checking.
//
// These are *pedagogical* trait stubs used by trait/bounds examples. They are NOT
// part of std — they exist only so illustrative snippets compile. Everything that
// std/the prelude provides in Fe 26.2.0 (Ctx, Log, assert!, revert, StorageMap,
// Default, Clone, the EVM intrinsics, ...) is used directly in the docs and has no
// stub here.
//
// Snippets opt in with e.g. `use _boilerplate::{Hashable, Printable}`.

mod _boilerplate {
    pub trait Hashable {
        fn hash(self) -> u256
    }

    pub trait Printable {
        fn to_string(self) -> String<31>
    }

    pub trait Readable {
        fn read(self) -> u256
    }

    pub trait Writable {
        fn write(mut self, value: u256)
    }
}
