/// A vault contract with traits, pattern matching,
/// and explicit effects.

use std::abi::sol

// Enums as error types
enum VaultError {
    InsufficientFunds,
    ZeroAmount,
}

// Traits define shared behavior
trait Validate {
    fn validate(self) -> Result<VaultError, u256>
}

struct Withdrawal {
    balance: u256,
    amount: u256,
}

impl Validate for Withdrawal {
    fn validate(self) -> Result<VaultError, u256> {
        if self.amount == 0 {
            return Result::Err(VaultError::ZeroAmount)
        }
        if self.balance < self.amount {
            return Result::Err(VaultError::InsufficientFunds)
        }
        Result::Ok(self.balance - self.amount)
    }
}

// Events with indexed fields for efficient filtering
#[event]
struct Deposited {
    #[indexed]
    owner: Address,
    amount: u256,
}

struct VaultStore {
    balances: StorageMap<Address, u256>,
}

// Message interface defines the contract's public ABI
msg VaultMsg {
    #[selector = sol("deposit()")]
    Deposit {},
    #[selector = sol("withdraw(uint256)")]
    Withdraw { amount: u256 },
    #[selector = sol("balanceOf(address)")]
    BalanceOf { addr: Address } -> u256,
}

// Effects declared explicitly, no hidden state access
pub contract Vault uses (ctx: Ctx, log: mut Log, call: mut Call) {
    mut store: VaultStore

    recv VaultMsg {
        #[payable]
        Deposit {} uses (ctx, mut store, mut log) {
            let who = ctx.caller()
            let balance = store.balances.get(key: who)
            store.balances.set(key: who, value: balance + ctx.value())
            log.emit(event: Deposited { owner: who, amount: ctx.value() })
        }

        // Pattern match on Result for control flow
        Withdraw { amount } uses (ctx, mut store, mut call) {
            let who = ctx.caller()
            let balance = store.balances.get(key: who)
            let req = Withdrawal { balance, amount }
            match req.validate() {
                Ok(new_bal) => {
                    store.balances.set(key: who, value: new_bal)
                    let outcome = call.send_value(addr: who, gas: ctx.gas(), value: amount)
                    assert!(outcome.success(), "withdrawal failed")
                }
                Err(VaultError::InsufficientFunds) => { revert_error(InsufficientFunds {}) }
                Err(VaultError::ZeroAmount) => { revert_error(ZeroAmount {}) }
            }
        }

        BalanceOf { addr } -> u256 uses (store) {
            store.balances.get(key: addr)
        }
    }
}

// Custom error payloads used by the validation branches.
#[error]
struct InsufficientFunds {}

#[error]
struct ZeroAmount {}

// Tests (not shown on landing page)
#[test]
fn validates_withdrawal() {
    let request = Withdrawal { balance: 100, amount: 40 }
    let remaining = match request.validate() {
        Ok(balance) => balance
        Err(_) => 0
    }
    assert!(remaining == 60)
    let empty = Withdrawal { balance: 100, amount: 0 }
    assert!(empty.validate().is_err())
    let excessive = Withdrawal { balance: 100, amount: 101 }
    assert!(excessive.validate().is_err())
}

msg VaultClientMsg {
    #[selector = sol("exercise(address)")]
    Exercise { vault: Address },
}

pub contract VaultClient {
    recv {
        #[payable]
        VaultClientMsg::Exercise { vault } uses (ctx: Ctx, call: mut Call) {
            call.call(addr: vault, gas: 300000, value: ctx.value(), message: VaultMsg::Deposit {})
            call.call(addr: vault, gas: 300000, value: 0, message: VaultMsg::Withdraw { amount: 40 })
        }
        #[payable]
        _ {}
    }
}

#[test(balance = 1000)]
fn withdrawal_transfers_eth() uses (evm: mut Evm) {
    let vault = evm.create2<Vault>(value: 0, args: (), salt: 0)
    let client = evm.create2<VaultClient>(value: 0, args: (), salt: 0)
    evm.call(addr: client, gas: 1000000, value: 100, message: VaultClientMsg::Exercise { vault })
    let remaining: u256 = evm.call(addr: vault, gas: 100000, value: 0,
        message: VaultMsg::BalanceOf { addr: client })
    assert!(remaining == 60)
    assert!(evm.balance(vault) == 60)
    assert!(evm.balance(client) == 40)
}

#[test(balance = 1000)]
fn rejected_payment_restores_balance() uses (evm: mut Evm) {
    let vault = evm.create2<Vault>(value: 0, args: (), salt: 0)
    evm.call(addr: vault, gas: 300000, value: 100, message: VaultMsg::Deposit {})
    // The test harness has no payable fallback and rejects the ETH payment.
    let outcome = evm.try_call(addr: vault, gas: 300000, value: 0,
        message: VaultMsg::Withdraw { amount: 40 })
    assert!(!outcome.success())
    let remaining: u256 = evm.call(addr: vault, gas: 100000, value: 0,
        message: VaultMsg::BalanceOf { addr: evm.address() })
    assert!(remaining == 100)
    assert!(evm.balance(vault) == 100)
}
