---
const base = import.meta.env.BASE_URL;
const registration = 'https://docs.google.com/forms/d/e/1FAIpQLSehDUUbqfQt67Ecy21zIsOFN7pp4orx9Ko9DKCWcDkjhEUVBg/viewform';
const submission = 'https://docs.google.com/forms/d/e/1FAIpQLSd2pqUkJzFpZMu5FVQP-NtetrIoB6nI-pHG1MLTOQhCpsLKqg/viewform';
const description = 'Explore Fe, build something worth sharing, and compete for $5,000. Three weeks to build with Fe. November 3–24, 2026.';
const directions = [
  { number: '01', title: 'Rethink a protocol', text: 'Reimagine an auction, exchange, or governance mechanism. Show how Fe makes the design clearer, more expressive, or more efficient.', tags: 'Protocols · DeFi · Governance' },
  { number: '02', title: 'Make the math work', text: 'Explore advanced arithmetic, proof verification, or cryptographic building blocks. Bring test vectors, explicit assumptions, and reusable abstractions.', tags: 'Math · Cryptography · Verification' },
  { number: '03', title: 'Build for the next builder', text: 'Create a library, a standard-library addition, or developer tooling with a meaningful Fe component. Build for the EVM or compile native tools that others can pick up and use.', tags: 'Libraries · Tooling · Developer experience' },
  { number: '04', title: 'Take us by surprise', text: 'Games, art, agents, social applications, or an experiment we haven’t imagined. Follow an interesting idea and show what Fe makes possible.', tags: 'Games · Art · Unexpected ideas' },
];
const judges = [
  { name: 'Austin Griffith', label: 'BuidlGuidl · Builder & educator', url: 'https://x.com/austingriffith', bio: 'Austin is the founder of BuidlGuidl and an Ethereum builder and educator. Through projects such as Scaffold-ETH and SpeedRunEthereum, he helps developers turn ideas into working applications.' },
  { name: 'Ahmed Castro', label: 'Filosofía Código · Developer & educator', url: 'https://x.com/FilosofiaCodigo', bio: 'Ahmed is a smart contract developer and educator behind Filosofía Código. His work spans Ethereum scaling, developer tooling, and technical education that helps developers build on Ethereum and its L2s.' },
  { name: 'Marius van der Wijden', label: 'Ethereum Foundation · Core developer', url: 'https://x.com/vdWijden', bio: 'Marius is an Ethereum core developer at the Ethereum Foundation, working on Geth. He focuses on testing, fuzzing, and making Ethereum’s execution layer more robust.' },
  { name: 'Philogy', label: '@real_philogy · Security researcher', url: 'https://x.com/real_philogy', bio: 'Philogy is the creator of Plank, a new smart contract language for the EVM, and a security researcher specializing in EVM internals and DeFi. His security review experience includes Solady and Uniswap’s The Compact.' },
  { name: 'Rahul Kothari', label: 'Ethereum Foundation', url: 'https://www.linkedin.com/in/iamrahulkothari/', bio: 'Rahul works at the Ethereum Foundation. Previously at Aztec, he built smart contracts for its privacy-focused L2 and later led product for the Aztec Sandbox and Devnet.' },
  { name: 'jistro', label: 'EVVM · Smart contract developer', url: 'https://x.com/jistro', bio: 'Jistro is a blockchain and smart contract developer contributing to EVVM. Their work includes Solidity contracts and TypeScript tooling for developers building on the EVM.' },
  { name: 'Grant Wuerker', label: 'Argot Collective · Fe core developer', url: 'https://github.com/g-r-a-n-t', bio: 'Grant has worked on Fe since 2020, starting with the first compiler’s support for contracts, storage, and ABI encoding. Today he focuses on Fe’s ingot and dependency system, ABI performance, and hardening the compiler through fuzzing.' },
  { name: 'Micah Scopes', label: 'Argot Collective · Fe core developer', url: 'https://github.com/micahscopes', bio: 'Micah has worked on Fe since 2023. He leads work on the language server, editor support, and documentation tooling, and also contributes to type checking and Sonatina code generation.' },
];
const criteria = [
  ['30%', 'Technical quality', 'Correctness, architecture, tests, and completeness.'],
  ['25%', 'Fe-specific value', 'Meaningful use of Fe’s features and abstractions.'],
  ['20%', 'Originality', 'A fresh idea, implementation, or combination.'],
  ['15%', 'Usefulness or insight', 'Value for users, researchers, or future builders.'],
  ['10%', 'Documentation & demo', 'A clear explanation and reproducible results.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fe Builders Challenge — $5,000 in prizes</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(`${base}contest/`, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Fe Builders Challenge — $5,000 in prizes" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(`${base}contest/`, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="dark">
      <header class="wrap header">
        <a class="brand" href={base} aria-label="Fe programming language home"><img src={`${base}fe-logo.svg`} alt="" width="42" height="42" /><span>The Fe Programming Language</span></a>
        <nav aria-label="Main navigation">
          <a href="#how-to-enter">How to enter</a>
          <a href={`${base}getting-started/what-is-fe/`}>Explore Fe <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <main id="main">
        <section class="wrap hero" aria-labelledby="contest-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Online contest · November 3–24, 2026</p>
            <h1 id="contest-title">Fe Builders<br /><span>Challenge.</span></h1>
            <p class="lead">A new language.<br />A different way to build.</p>
            <p class="intro">A useful library, a clever protocol, a strange experiment. Whatever your idea, build it with Fe.</p>
            <div class="actions">
              <a class="button primary" href={registration}>Register your project <span aria-hidden="true">↗</span></a>
              <a class="button secondary" href={submission}>Submit a project <span aria-hidden="true">↗</span></a>
            </div>
            <p class="micro">Solo or team. Fully online. AI assistance welcome.</p>
          </div>
          <aside class="prize" aria-label="Prize pool">
            <div class="prize-top"><span>BUILD SOMETHING THAT MATTERS</span><img src={`${base}fe-logo.svg`} width="42" height="42" alt="" /></div>
            <p class="prize-total">$5,000</p>
            <p class="prize-caption">in prizes. Funded by the <a href="https://argot.org">Argot Collective</a>.</p>
            <div class="prize-row"><span><b>01</b> First place</span><strong>$2,500</strong></div>
            <div class="prize-row"><span><b>02</b> Second place</span><strong>$1,500</strong></div>
            <div class="prize-row"><span><b>03</b> Third place</span><strong>$1,000</strong></div>
            <p class="prize-note">One competition. Every project competes in the same pool.</p>
          </aside>
        </section>
        <div class="timeline-wrap">
          <ol class="wrap timeline" aria-label="Contest timeline">
            <li><span class="step">01 / BUILD</span><strong>Nov 3</strong><span>Build window opens</span></li>
            <li><span class="step">02 / REGISTER</span><strong>Nov 17</strong><span>Register by 23:59 UTC</span></li>
            <li><span class="step">03 / SUBMIT</span><strong>Nov 24</strong><span>Submit by 23:59 UTC</span></li>
            <li><span class="step">04 / RESULTS</span><strong>Dec 1</strong><span>Results · target date</span></li>
          </ol>
        </div>
        <div class="paper">
          <section class="wrap section" aria-labelledby="ideas-title">
            <div class="section-heading"><p class="eyebrow ink">THE POSSIBILITIES</p><h2 id="ideas-title">What will you build?</h2><p>A focused library can be as compelling as a whole application. These are starting points, not separate tracks. Make the idea your own.</p></div>
            <div class="ideas">{directions.map((item) => <article class="idea"><span class="number">{item.number}</span><h3>{item.title}</h3><p>{item.text}</p><p class="tags">{item.tags}</p></article>)}</div>
          </section>
          <section class="entry-section" id="how-to-enter" aria-labelledby="entry-title">
            <div class="wrap section entry-grid">
              <div><p class="eyebrow ink">FROM IDEA TO ENTRY</p><h2 id="entry-title">Three weeks.<br />Make them count.</h2><p>New to Fe? You’re welcome here. Start with a small idea, get it working, and show us what you learned.</p><a class="text-link" href={`${base}getting-started/first-contract/`}>Write your first Fe contract <span aria-hidden="true">→</span></a></div>
              <ol class="entry-steps">
                <li><span class="number">01</span><div><h3>Explore now. Build from November 3.</h3><p>Read the <a href={`${base}getting-started/installation/`}>installation guide</a> and experiment with Fe. The build window opens on November 3 at 00:00 UTC. Only substantial work completed during the contest window will be judged. The supported contest toolchain will be listed here before launch.</p></div></li>
                <li><span class="number">02</span><div><h3>Register by November 17.</h3><p>Tell us your project idea, team, and contact email. Your idea can evolve; you don’t need a finished project. We’ll email your project ID and private submission link.</p><a class="text-link" href={registration}>Open registration <span aria-hidden="true">↗</span></a></div></li>
                <li><span class="number">03</span><div><h3>Submit by November 24.</h3><p>Use your personal submission link to send your public repository and exact commit. You can submit again before the deadline; the latest valid submission counts.</p><a class="text-link" href={submission}>Open submission form <span aria-hidden="true">↗</span></a></div></li>
              </ol>
            </div>
          </section>
          <section class="wrap section review-grid" aria-labelledby="review-title">
            <div><p class="eyebrow ink">THE REVIEW</p><h2 id="review-title">Good ideas.<br />Solid execution.</h2><p>Judges review submissions independently, then consider a shortlist to select the winners. We plan one week for judging and aim to announce the winners on December 1. The jury’s decisions are final.</p>
            </div>
            <div class="rubric" aria-label="Judging criteria">{criteria.map(([weight, title, text]) => <div class="criterion"><strong>{weight}</strong><div><h3>{title}</h3><p>{text}</p></div></div>)}<p class="rubric-note">Your evidence should fit your project: tests, benchmarks, test vectors, or a working demo. Social reach does not affect your score.</p></div>
          </section>
          <section class="jury-section" aria-labelledby="jury-title">
            <div class="wrap section">
              <div class="section-heading"><p class="eyebrow ink">THE JURY</p><h2 id="jury-title">Meet your judges.</h2></div>
              <ul class="judge-list">
                {judges.map((judge) => <li class="judge"><h3><a href={judge.url}>{judge.name}<span aria-hidden="true">↗</span></a></h3><p class="judge-label">{judge.label}</p><p class="judge-bio">{judge.bio}</p></li>)}
              </ul>
            </div>
          </section>
          <section class="wrap section essentials" aria-labelledby="essentials-title">
            <div><p class="eyebrow ink">READY TO SUBMIT?</p><h2 id="essentials-title">Give your work<br />a good handoff.</h2><p>Your core technical contribution must be in Fe. Frontends, scripts, and supporting tools can use other languages.</p></div>
            <ul class="checklist">
              <li>A public GitHub repository with an OSI-approved license.</li>
              <li>The full commit SHA, project manifest, and exact Fe version.</li>
              <li>Reproducible build instructions and appropriate automated tests.</li>
              <li>A README covering the approach, architecture, and limitations.</li>
              <li>A short pitch, a Fe-specific highlight, and a demo or reproducible example.</li>
              <li>A declaration of pre-existing work, reused code, and AI assistance.</li>
            </ul>
          </section>
          <section class="wrap section faq" aria-labelledby="faq-title">
            <p class="eyebrow ink">A FEW MORE DETAILS</p><h2 id="faq-title">Before you begin.</h2>
            <div class="faq-group">
              <h3>Taking part</h3>
              <details><summary>Who can participate?</summary><p>The contest is open worldwide, to beginners and experienced developers alike. Members of the Argot Collective and contest judges are not eligible to participate.</p></details>
              <details><summary>Can I enter solo or with a team?</summary><p>Both are welcome. There is no team-size limit, and your team can change after registration. Each project needs one contact person reachable by email. Team membership, responsibilities, and any prize split are for the team to agree on internally.</p></details>
              <details><summary>Can I enter more than one project or join multiple teams?</summary><p>Yes. You can submit multiple distinct projects and participate in multiple teams. Register each project separately. Do not submit multiple variants of the same work as separate entries.</p></details>
              <details><summary>Do I need a finished idea to register?</summary><p>No. Your initial idea is not binding and can change as you explore Fe. Register by November 17 at 23:59 UTC with a contact email we can reach. You can start building before registering, but registration is required to submit.</p></details>
              <details><summary>What are the deadlines?</summary><p>All times are UTC. The build window opens on November 3, 2026 at 00:00. Registration closes on November 17 at 23:59, and final submissions close on November 24 at 23:59. Registration and preparatory experiments are welcome before the build window opens. The registration deadline is firm; exceptions apply only if a problem on our side prevents registration.</p></details>
            </div>
            <div class="faq-group">
              <h3>Building with Fe</h3>
              <details><summary>Does my project need to use the EVM or a blockchain?</summary><p>No. Fe supports both the EVM and native code, and purely native projects are welcome. Developer tools are one exciting direction; your project does not need a smart contract or any blockchain connection. The core technical contribution must be in Fe.</p></details>
              <details><summary>Do library and tooling projects qualify?</summary><p>Yes, with a meaningful Fe contribution central to the project. Standard-library submissions do not need to be merged upstream before the deadline. Pure compiler contributions are outside this contest’s scope.</p></details>
              <details><summary>Can I use AI tools?</summary><p>Yes. AI assistance is welcome and is not scored negatively. Disclose how you used it, test the result, and be prepared to explain your code. Every project needs one responsible human contact.</p></details>
              <details><summary>Can I enter an existing project?</summary><p>Yes, but only substantial work completed during November 3–24 is judged. Identify the starting point and explain what changed. New feature work after the final deadline is not eligible.</p></details>
              <details><summary>What if I run into a Fe compiler bug?</summary><p>Report the bug in the <a href="https://github.com/argotorg/fe/issues">Fe issue tracker</a>, ideally with a minimal example, and let us know on <a href="https://fe-lang.zulipchat.com">Zulip</a> if it blocks your entry. We’ll work with you to find a solution.</p></details>
              <details><summary>Where can I ask questions?</summary><p>Join <a href="https://fe-lang.zulipchat.com">Fe on Zulip</a> for help, ideas, and progress updates. Office-hours dates will be announced before the build window opens.</p></details>
            </div>
            <div class="faq-group">
              <h3>Submissions &amp; review</h3>
              <details><summary>Can I submit a prototype or unfinished project?</summary><p>Yes. A working prototype is enough if you can demonstrate the core contribution and clearly document what works, what is unfinished, and any limitations. Completeness is part of technical quality, but your project does not need to be production-ready.</p></details>
              <details><summary>Is a video or live presentation required?</summary><p>No. Provide reproducible instructions so judges can build and try your project. An optional video or demo can help communicate your work and support your score in the Documentation &amp; demo category.</p></details>
              <details><summary>Do I need to deploy to mainnet?</summary><p>No. Mainnet deployment provides no scoring advantage. A testnet deployment is sufficient where deployment helps demonstrate the project. Native projects do not need a blockchain deployment at all.</p></details>
              <details><summary>Can I update my submission?</summary><p>Yes. Use your personal submission link to submit again before November 24 at 23:59 UTC. The latest valid submission counts. Include the exact commit SHA you want judged.</p></details>
              <details><summary>How do I know my registration or submission is valid?</summary><p>A successful registration is confirmed by email with your project ID and private submission link. For submissions, an email confirms whether the automated checks passed or explains what needs correcting. The form’s receipt alone is not confirmation of acceptance. Technical eligibility is reviewed separately. If you don’t receive confirmation, check your spam folder or ask us on <a href="https://fe-lang.zulipchat.com">Zulip</a>.</p></details>
              <details><summary>What happens after the submission deadline?</summary><p>Judges review the submitted commit. We may contact you to clarify missing information or build instructions; please reply within 48 hours. Clarifications after the deadline are allowed only at our request and must not introduce new code changes. Without a reply, we assess the project using the information available.</p></details>
              <details><summary>What if the judges cannot run my project?</summary><p>A minor setup issue does not automatically disqualify your project; we may ask for clarification. Reproducibility and completeness affect technical quality, and the core contribution must be verifiable for the project to be eligible.</p></details>
            </div>
            <div class="faq-group">
              <h3>Results &amp; prizes</h3>
              <details><summary>When and where will the winners be announced?</summary><p>We aim to announce the winners on December 1, 2026 via the Fe blog and X, then notify the winners by email. If judging takes longer, we’ll announce the delay publicly. The jury’s decisions are final.</p></details>
              <details><summary>Is the prize pool guaranteed?</summary><p>Yes. All three prizes will be awarded: $2,500 for first place, $1,500 for second, and $1,000 for third. The full $5,000 prize pool is funded by the Argot Collective.</p></details>
              <details><summary>How and when are prizes paid?</summary><p>Prizes are paid in USDC on Ethereum Mainnet. After the winners are announced, we’ll contact each winning project through its registered email to request and confirm one payout address. We aim to pay within one week once that address is confirmed. Teams are responsible for distributing the prize among their members.</p></details>
              <details><summary>Will I receive feedback? Will my project be featured?</summary><p>Individual feedback is not guaranteed. We reserve the right to publicly showcase any submitted project, including entries that do not win a prize.</p></details>
            </div>
          </section>
          <section class="wrap final-cta"><div><p class="eyebrow">YOUR NEXT IDEA, IN FE</p><h2>Let’s see what<br />you can build.</h2></div><div><a class="button white" href={registration}>Register your project <span aria-hidden="true">↗</span></a><a class="submission-link" href={submission}>Already registered? Submit your project →</a></div></section>
        </div>
      </main>
      <footer class="wrap footer"><a class="brand" href={base}><img src={`${base}fe-logo.svg`} width="32" height="32" alt="Fe" /><span>Fe Builders Challenge · 2026</span></a><div><a href={`${base}getting-started/what-is-fe/`}>Documentation</a><a href="https://fe-lang.zulipchat.com">Zulip</a><a href="https://github.com/argotorg/fe">GitHub</a></div></footer>
    </div>
  </body>
</html>
<style>
