---
// Serve the fe doc viewer at /docs/ with theme overrides.
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';

const dir = dirname(fileURLToPath(import.meta.url));
let html = fs.readFileSync(join(dir, '../../../public/docs/index.html'), 'utf-8');

// Inject theme override before </head>
html = html.replace('</head>', '<link rel="stylesheet" href="/docs/theme.css">\n</head>');
---
<Fragment set:html={html} />
