---
import { DOC_URL as docUrl } from '../../consts';

---
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Fe API Documentation</title>
</head>
<body>
  <p>Redirecting to <a href={docUrl}>docs.fe-lang.dev</a>...</p>
  <script define:vars={{ docUrl }}>
    window.location.replace(docUrl + window.location.hash);
  </script>
</body>
</html>
