---
const docUrl = import.meta.env.PUBLIC_DOC_URL || 'https://fe-lang.github.io/fe-docs/';
---
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content={`0; url=${docUrl}`}>
  <title>Fe API Documentation</title>
</head>
<body>
  <p>API documentation has moved to <a href={docUrl}>doc.fe-lang.org</a>.</p>
</body>
</html>
