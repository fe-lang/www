  <script>
    let menuBtn = document.querySelector('#menu-btn');
    let menu = document.querySelector('#menu');
    let menuIcon = document.querySelector('#menu-icon');
    let closeIcon = document.querySelector('#close-icon');

    function toggleMenu() {
        menu.classList.toggle('block');
        menu.classList.toggle('hidden');
        menuIcon.classList.toggle('block');
        menuIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('block');
        closeIcon.classList.toggle('hidden');
    }

    menuBtn.addEventListener('click', toggleMenu);

    // Copy install commands to clipboard
    document.querySelectorAll('[data-copy-install]').forEach(function(copyBtn) {
      copyBtn.addEventListener('click', function() {
        let installRow = copyBtn.closest('[data-install-row]');
        let copyIcon = installRow?.querySelector('[data-copy-icon]');
        let checkIcon = installRow?.querySelector('[data-check-icon]');
        let installCmd = installRow?.querySelector('[data-install-command]');

        if (!copyIcon || !checkIcon || !installCmd) {
          return;
        }

        navigator.clipboard.writeText(installCmd.textContent.trim()).then(function() {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          setTimeout(function() {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
          }, 2000);
        });
      });
    });
  </script>
  <script is:inline src="https://unpkg.com/@highlightjs/cdn-assets@11.9.0/highlight.min.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // Register Fe language (based on Rust with Fe-specific keywords)
      hljs.registerLanguage('fe', function(hljs) {
        return {
          name: 'Fe',
          keywords: {
            keyword: 'pub contract struct enum fn let mut if else match return true false self use const impl trait where for in loop break continue msg recv uses init',
            type: 'u8 u16 u32 u64 u128 u256 i8 i16 i32 i64 i128 i256 bool Address String Map Option Result Self',
            built_in: 'ctx log Ctx Log Default Add Sub Encode Decode'
          },
          contains: [
            hljs.COMMENT('//', '$'),
            hljs.COMMENT('/\\*', '\\*/'),
            hljs.QUOTE_STRING_MODE,
            {
              className: 'meta',
              begin: '#\\[', end: '\\]'
            },
            hljs.C_NUMBER_MODE,
            {
              className: 'function',
              beginKeywords: 'fn', end: '\\(',
              contains: [hljs.TITLE_MODE]
            },
            {
              className: 'class',
              beginKeywords: 'struct enum contract msg trait', end: '[\\{<]',
              contains: [hljs.TITLE_MODE]
            }
          ]
        };
      });
      hljs.highlightAll();
    });
  </script>
